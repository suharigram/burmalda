# Public website URL used for Stripe success/cancel redirects
# PUBLIC_URL=http://localhost:5173
# PORT=4173

# Form delivery: configure SMTP, a webhook, or both.
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# INQUIRY_TO_EMAIL=sales@gonidoncloud.com
# MAIL_FROM=GonidonCloud <website@gonidoncloud.com>
# FORM_WEBHOOK_URL=https://hooks.example.com/gonidoncloud-forms

# Stripe hosted card checkout (use test keys during development)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_AUTOMATIC_TAX=false

# OAuth sign-in. Register each callback as PUBLIC_URL/api/auth/PROVIDER/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Alternatively, supply a pre-generated short-lived APPLE_CLIENT_SECRET.

# Signed driver release URLs (downloads stay unpublished until configured)
# FPU_LINUX_DRIVER_URL=
# FPU_FIRMWARE_URL=
# FPU_SDK_URL=
