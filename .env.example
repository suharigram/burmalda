# Supabase project settings. The publishable key replaces the legacy anon key.
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase PostgreSQL. Use the Session Pooler connection string for Vercel.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# PGSSL=true
# PG_POOL_MAX=3

# Public website URL used for metadata, OAuth callbacks, and Stripe redirects.
# PUBLIC_URL=http://localhost:3000

# Form delivery: configure SMTP, a webhook, or both.
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# INQUIRY_TO_EMAIL=sales@mindpick.com
# MAIL_FROM=Mindpick <website@mindpick.com>
# FORM_WEBHOOK_URL=https://hooks.example.com/mindpick-forms

# Stripe hosted card checkout (use test keys during development).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Enable Google and GitHub in Supabase Dashboard -> Authentication -> Sign In / Providers.
# Add PUBLIC_URL/api/auth/PROVIDER/callback and PUBLIC_URL/api/auth/confirm to Authentication -> URL Configuration.
# Email sign-up, password login, confirmation, and recovery use the same Supabase project.
# Google and GitHub OAuth credentials are entered in Supabase, not in this website environment.

# Signed driver release URLs (downloads stay unpublished until configured).
# FPU_LINUX_DRIVER_URL=
# FPU_FIRMWARE_URL=
# FPU_SDK_URL=
